{
  "name": "envis-dashboard",
  "private": true,
  "version": "1.3.9",
  "type": "module",
  "description": "DENR-EMB Region VII Environmental Permits Monitoring Dashboard",
  "scripts": {
    "predev": "node scripts/ensure-planning.mjs && node scripts/ensure-api.mjs",
    "dev": "vite",
    "predev:lan": "node scripts/ensure-planning.mjs && node scripts/ensure-api.mjs",
    "dev:lan": "node scripts/lan.mjs",
    "ensure-api": "node scripts/ensure-api.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:fetch": "node scripts/fetch-sheets.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:trim": "node scripts/trim-public-data.mjs",
    "data:spatial": "node scripts/build-spatial.mjs",
    "data:legal": "node scripts/build-legal.mjs",
    "data:legal:check": "node scripts/build-legal.mjs --check",
    "data:swm": "node scripts/build-swm.mjs",
    "data:ecc": "node scripts/build-ecc-ultralist.mjs",
    "data:aqms": "node scripts/fetch-aqms.mjs",
    "data:emed": "node scripts/build-emed.mjs --fetch",
    "data:planning": "node scripts/build-planning.mjs",
    "planning:serve": "node scripts/planning-service.mjs",
    "data:pco": "node scripts/fetch-pco.mjs",
    "data:pco:analysis": "node scripts/build-pco-analysis.mjs",
    "data:ecc:apply": "node scripts/apply-ecc-ultralist.mjs",
    "data:all": "npm run data:fetch && npm run data:spatial && npm run data:build && npm run data:ecc && npm run data:aqms && npm run data:emed && npm run data:pco && npm run data:pco:analysis && npm run data:legal && npm run data:swm && npm run data:trim && npm run data:validate",
    "test": "node --import tsx --test tests/*.test.ts",
    "version:bump": "node scripts/bump-version.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "data:validate": "tsx scripts/validate-output.ts",
    "api:dev": "wrangler dev --config worker/wrangler.toml --local --port 8787",
    "api:db": "wrangler d1 migrations apply envis --local --config worker/wrangler.toml",
    "api:seed": "node worker/scripts/seed-accounts.mjs",
    "api:seed:apply": "wrangler d1 execute envis --local --config worker/wrangler.toml --file=worker/.local/seed.sql",
    "api:upload": "node worker/scripts/upload-data.mjs --local",
    "api:upload:remote": "node worker/scripts/upload-data.mjs --remote",
    "api:typecheck": "tsc -p worker/tsconfig.json",
    "live": "node scripts/serve-live.mjs",
    "live:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action run -Lan",
    "live:lan:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action install -Lan",
    "live:lan:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action status -Lan",
    "live:lan:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action restart -Lan",
    "live:lan:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action uninstall -Lan",
    "live:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action status",
    "live:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action restart",
    "live:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action install",
    "live:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action uninstall",
    "refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh.ps1 -Action run",
    "refresh:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh.ps1 -Action install",
    "refresh:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh.ps1 -Action status",
    "refresh:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh.ps1 -Action uninstall"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "5.6.0",
    "echarts-for-react": "3.0.2",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "lucide-react": "0.474.0",
    "motion": "^14.14.0",
    "playwright": "^1.65.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/leaflet": "1.9.16",
    "@types/leaflet.markercluster": "1.5.5",
    "@types/node": "22.10.7",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "mapshaper": "0.6.102",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "wrangler": "^4.164.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "workerd@1.20261117.1": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
