# Credentials (never commit)
CREDENTIALS.md

# Build / deps
node_modules/
dist/
logs/

# Cloudflare Worker local state and generated secrets
worker/.local/
worker/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Source spatial data (shapefiles) — provided separately, not published
spatial-src/

# Raw source data and pinned snapshots (large / internal)
data/raw/
data/legal/

# Generated reports (review queues)
reports/

# Local workbook-audit evidence: contains a copy of the private planning
# workbook, so it must never be committed.
screenshots/planning-evidence/

# Desktop app build output (the .exe is generated locally, not source)
desktop/bin/
desktop/obj/
desktop/publish/
desktop/dist/
desktop/installer/bin/
desktop/installer/obj/
desktop/installer/publish/

# Environment
.env
.env.local

# Environment-specific npm config
.npmrc

# Tooling artifacts
.specstory/
assets/

# Pixel Office artwork must stay tracked (the generic assets/ rule above
# would otherwise strip the floor-map image from a fresh clone).
!ENVIS-Pixel-Office/public/assets/
!ENVIS-Pixel-Office/public/assets/**
!public/pixel-office/assets/
!public/pixel-office/assets/**
