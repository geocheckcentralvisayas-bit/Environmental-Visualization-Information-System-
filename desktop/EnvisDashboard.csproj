<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ENVISDashboard</AssemblyName>
    <RootNamespace>EnvisDashboard</RootNamespace>
    <ApplicationIcon>assets\envis.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- One portable .exe: the .NET runtime ships inside it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- WebView2 also ships a WPF assembly that references WindowsBase 5.x; the
         WinForms target only uses the WinForms build, so the conflict is inert. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <Version>1.3.10</Version>
    <FileVersion>1.3.10.0</FileVersion>
    <AssemblyVersion>1.3.10.0</AssemblyVersion>
    <Product>ENVIS Dashboard</Product>
    <Description>ENVIS Region VII dashboard as a Windows desktop application.</Description>
    <Company>Environmental Management Bureau Region VII</Company>
    <Copyright>Environmental Management Bureau Region VII</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <!-- The installer is its own project in desktop\installer. -->
  <ItemGroup>
    <Compile Remove="installer\**" />
    <None Remove="installer\**" />
    <EmbeddedResource Remove="installer\**" />
  </ItemGroup>

</Project>
